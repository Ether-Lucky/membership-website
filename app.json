{
  "expo": {
    "name": "MemberPortal",
    "slug": "member-portal",
    "version": "1.0.0",
    "scheme": "memberportal",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1F3D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourorg.memberportal",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to take your profile photo for your membership card.",
        "NSPhotoLibraryUsageDescription": "Used to select your profile photo for your membership card."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1F3D"
      },
      "package": "com.yourorg.memberportal",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MemberPortal to access your photos for your membership card.",
          "cameraPermission": "Allow MemberPortal to use the camera to take your membership photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
