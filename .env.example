# .env.example
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── Supabase (get these from: supabase.com → your project → Settings → API) ──
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── App settings ──────────────────────────────────────────────────────────────
# The public URL of your deployed app (used inside QR codes)
EXPO_PUBLIC_APP_URL=https://yourapp.com
EXPO_PUBLIC_ORG_NAME=Your Organization Name

# ── Server-side only — NEVER prefix with EXPO_PUBLIC_ ─────────────────────────
# Used only inside Supabase Edge Functions. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
